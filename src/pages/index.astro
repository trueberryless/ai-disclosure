---
import ThemeSelect from "../components/ThemeSelect.astro";
import * as disclosure from "../content/ai-disclosure.md";
import Layout from "../layouts/Layout.astro";

const { Content, frontmatter } = disclosure;
---

<Layout title={frontmatter.title} description={frontmatter.description}>
  <header>
    <div class="header-inner">
      <h1>{frontmatter.title}</h1>
      <ThemeSelect />
    </div>
    <p class="lead">{frontmatter.description}</p>
  </header>

  <main id="content">
    <Content />
  </main>
</Layout>

<style>
  header {
    border-block-end: 1px solid var(--border);
    margin-inline: auto;
    max-inline-size: var(--measure);
    padding: clamp(1.5rem, 5vw, 3.5rem) var(--gutter) 2rem;
  }

  .header-inner {
    align-items: start;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
  }

  h1 {
    font-size: clamp(2.25rem, 7vw, 3.5rem);
    line-height: 1.1;
    margin: 0;
    text-wrap: balance;
  }

  .lead {
    color: var(--muted);
    font-size: 1.15rem;
    margin-block: 1.25rem 0;
  }

  main {
    margin-inline: auto;
    max-inline-size: var(--measure);
    padding: 1rem var(--gutter) 4rem;
  }
</style>
